# Copy to .env for docker compose or local development. In Kubernetes the same
# settings live in k8s/base/configmap.yaml and the overload-secrets / overload-db Secrets.

# --- Database ---
POSTGRES_USER=overload
POSTGRES_PASSWORD=change-me
POSTGRES_DB=overload
# For local development without compose, either set DATABASE_URL or PGHOST/PGUSER/PGPASSWORD/PGDATABASE.
# DATABASE_URL=postgres://overload:change-me@localhost:5432/overload

# --- Public URL (needed for OIDC redirects) ---
PUBLIC_URL=http://localhost:8080

# --- AI ---
# anthropic (Claude) or openai (any OpenAI-compatible API: OpenAI, Ollama, LM Studio, LiteLLM)
AI_PROVIDER=anthropic
AI_API_KEY=
# Defaults: claude-sonnet-5-5 for anthropic, gpt-4o-mini for openai
AI_MODEL=
# Only for self-hosted/compatible endpoints, e.g. http://ollama:11434/v1
AI_BASE_URL=
AI_LANGUAGE=English

# --- Authentication: none | password | proxy | oidc ---
AUTH_MODE=none
# Recommended in every mode except none; generated and stored in the database when empty.
SESSION_SECRET=
SESSION_DAYS=30

# password mode
APP_PASSWORD=

# oidc mode (Authentik: OAuth2/OpenID provider)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_PROVIDER_NAME=Authentik

# proxy mode (Authentik proxy outpost / forward auth); these are the defaults
PROXY_USER_HEADER=x-authentik-username
PROXY_EMAIL_HEADER=x-authentik-email
PROXY_GROUPS_HEADER=x-authentik-groups
PROXY_LOGOUT_URL=/outpost.goauthentik.io/sign_out

# Optional allowlists for oidc and proxy mode (comma separated)
ALLOWED_USERS=
ALLOWED_GROUPS=
