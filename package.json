{
  "name": "overload",
  "version": "1.5.0",
  "private": true,
  "description": "Personal AI-assisted strength training app with automatic progressive overload",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.ts",
    "migrate": "node --disable-warning=ExperimentalWarning server/migrate.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'server/tests/*.test.ts'",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "build": "npm --prefix web run build",
    "build:web": "npm --prefix web run build",
    "seed:demo": "node --disable-warning=ExperimentalWarning server/scripts/seedDemo.ts",
    "import:exercises": "node --disable-warning=ExperimentalWarning server/scripts/importExercises.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.7",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "oidc-provider": "^9.13.3",
    "typescript": "^5.9.3"
  }
}
